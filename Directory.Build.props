<Project>
  <PropertyGroup>
    <!-- Prevent file locking issues -->
    <CreateHardLinksForCopyAdditionalFilesIfPossible>false</CreateHardLinksForCopyAdditionalFilesIfPossible>
    <CreateSymbolicLinksForCopyAdditionalFilesIfPossible>false</CreateSymbolicLinksForCopyAdditionalFilesIfPossible>
    <CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>false</CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>
    <CreateSymbolicLinksForCopyFilesToOutputDirectoryIfPossible>false</CreateSymbolicLinksForCopyFilesToOutputDirectoryIfPossible>
    <CreateHardLinksForCopyLocalIfPossible>false</CreateHardLinksForCopyLocalIfPossible>
    <CreateSymbolicLinksForCopyLocalIfPossible>false</CreateSymbolicLinksForCopyLocalIfPossible>
    
    <!-- Improve build reliability -->
    <CopyRetryCount>10</CopyRetryCount>
    <CopyRetryDelayMilliseconds>500</CopyRetryDelayMilliseconds>
    <OverwriteReadOnlyFiles>true</OverwriteReadOnlyFiles>
    <SkipCopyUnchangedFiles>true</SkipCopyUnchangedFiles>
    
    <!-- Prevent unnecessary file copying during debugging -->
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    
    <!-- Optimize for development -->
    <UseCommonOutputDirectory>false</UseCommonOutputDirectory>
    
    <!-- Disable some features that can cause file locks -->
    <DisableRarCache>false</DisableRarCache>
    <DisableAutoGeneratedBindingRedirects>false</DisableAutoGeneratedBindingRedirects>
  </PropertyGroup>
</Project>